# Copy to .env on each machine and change the values. Never commit .env.
POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me-local-only
# Password of relay_migrator, the limited role the worker uses on target_db. dbinit creates
# the role with it. Letters and digits only: it is placed inside a connection URL.
TARGET_MIGRATOR_PASSWORD=change-me-too-local-only
